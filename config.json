{
  "appName": "noni",
  "sidebarWidth": 25,
  "lineNumberWidth": 7,
  "escDelayMs": 25,
  "syntaxAutoInstall": true,
  "terminal": {
    "shell": "",
    "height": 12,
    "scrollback": 5000
  },
  "extensions": {
    "noni.hello": {
      "greet": "Welcome back"
    }
  },
  "lsp": {
    "autoInstall": true,
    "servers": [
      {
        "language": "cpp",
        "command": ["clangd"],
        "rootMarkers": ["compile_commands.json", ".git"]
      },
      {
        "language": "python",
        "command": ["pylsp"],
        "rootMarkers": ["pyproject.toml", ".git"]
      }
    ]
  },
  "keybindings": [
    {
      "key": "escape",
      "command": "noni.mode.normal",
      "when": ""
    },
    {
      "key": "ctrl+s",
      "command": "workbench.action.files.save",
      "when": "editorFocus"
    },
    {
      "key": "ctrl+w",
      "command": "workbench.action.closeActiveEditor",
      "when": "editorFocus && normalMode"
    },
    {
      "key": "ctrl+p",
      "command": "noni.search.files",
      "when": "editorFocus && normalMode || sidebarFocus || searchFocus"
    },
    {
      "key": "ctrl+shift+f",
      "command": "workbench.action.findInFiles",
      "when": "editorFocus && normalMode || searchFocus || sidebarFocus"
    },
    {
      "key": "space shift+f",
      "command": "workbench.action.findInFiles",
      "when": "editorFocus && normalMode || searchFocus || sidebarFocus"
    },
    {
      "key": "ctrl+b",
      "command": "workbench.action.toggleSidebarVisibility",
      "when": "editorFocus && normalMode || sidebarFocus || searchFocus"
    },
    {
      "key": "ctrl+t",
      "command": "workbench.action.terminal.toggle",
      "when": "editorFocus && normalMode || terminalFocus || sidebarFocus || searchFocus"
    },
    {
      "key": "ctrl+y",
      "command": "editor.action.redo",
      "when": "editorFocus && normalMode"
    },
    {
      "key": "ctrl+v",
      "command": "editor.action.clipboardPasteAction",
      "when": "editorFocus && normalMode"
    },
    {
      "key": "ctrl+space",
      "command": "editor.action.triggerSuggest",
      "when": "editorFocus"
    },
    {
      "key": "ctrl+backslash",
      "command": "workbench.action.splitEditorRight",
      "when": "editorFocus && normalMode"
    },
    {
      "key": "ctrl+k s",
      "command": "workbench.action.splitEditorDown",
      "when": "editorFocus && normalMode"
    },
    {
      "key": "ctrl+k q",
      "command": "workbench.action.closeActiveEditorGroup",
      "when": "editorFocus && normalMode"
    },
    {
      "key": "ctrl+k h",
      "command": "workbench.action.focusLeftGroup",
      "when": "editorFocus && normalMode"
    },
    {
      "key": "ctrl+k l",
      "command": "workbench.action.focusRightGroup",
      "when": "editorFocus && normalMode"
    },
    {
      "key": "ctrl+k k",
      "command": "workbench.action.focusAboveGroup",
      "when": "editorFocus && normalMode"
    },
    {
      "key": "ctrl+k j",
      "command": "workbench.action.focusBelowGroup",
      "when": "editorFocus && normalMode"
    },
    {
      "key": "ctrl+k leftbracket",
      "command": "workbench.action.decreaseViewWidth",
      "when": "editorFocus && normalMode"
    },
    {
      "key": "ctrl+k rightbracket",
      "command": "workbench.action.increaseViewWidth",
      "when": "editorFocus && normalMode"
    },
    {
      "key": "ctrl+k underscore",
      "command": "workbench.action.decreaseViewHeight",
      "when": "editorFocus && normalMode"
    },
    {
      "key": "ctrl+k equals",
      "command": "workbench.action.increaseViewHeight",
      "when": "editorFocus && normalMode"
    },
    {
      "key": "space ;",
      "command": "workbench.action.showAllEditors",
      "when": "editorFocus && normalMode || sidebarFocus || searchFocus"
    },
    {
      "key": "space o",
      "command": "workbench.action.openWorkspace",
      "when": "editorFocus && normalMode || sidebarFocus || searchFocus"
    },
    {
      "key": "space .",
      "command": "noni.explorer.revealActive",
      "when": "editorFocus && normalMode"
    },
    {
      "key": "space e",
      "command": "workbench.view.explorer",
      "when": "editorFocus && normalMode || searchFocus"
    },
    {
      "key": "space e",
      "command": "noni.focus.editor",
      "when": "sidebarFocus"
    },
    {
      "key": "tab",
      "command": "noni.focus.toggleSidebar",
      "when": "editorFocus && normalMode || sidebarFocus"
    },
    {
      "key": ":",
      "command": "noni.command.open",
      "when": "editorFocus && normalMode"
    },
    {
      "key": "g t",
      "command": "workbench.action.nextEditor",
      "when": "editorFocus && normalMode"
    },
    {
      "key": "g g",
      "command": "editor.action.goToFileStart",
      "when": "editorFocus && normalMode"
    },
    {
      "key": "g shift+t",
      "command": "workbench.action.previousEditor",
      "when": "editorFocus && normalMode"
    },
    {
      "key": "u",
      "command": "editor.action.undo",
      "when": "editorFocus && normalMode"
    },
    {
      "key": "space g r",
      "command": "git.refresh",
      "when": "editorFocus && normalMode || sidebarFocus"
    },
    {
      "key": "space g s",
      "command": "git.showStatus",
      "when": "editorFocus && normalMode || sidebarFocus"
    },
    {
      "key": "space g a",
      "command": "git.stage",
      "when": "editorFocus && normalMode || sidebarFocus"
    },
    {
      "key": "space g u",
      "command": "git.unstage",
      "when": "editorFocus && normalMode || sidebarFocus"
    },
    {
      "key": "space g x",
      "command": "git.discard",
      "when": "editorFocus && normalMode"
    },
    {
      "key": "space g d",
      "command": "git.showDiff",
      "when": "editorFocus && normalMode"
    },
    {
      "key": "space g f",
      "command": "git.refreshDiff",
      "when": "editorFocus && normalMode"
    },
    {
      "key": "space m s",
      "command": "workbench.action.saveSession",
      "when": "editorFocus && normalMode"
    },
    {
      "key": "space m r",
      "command": "workbench.action.restoreSession",
      "when": "editorFocus && normalMode"
    },
    {
      "key": "space l s",
      "command": "lsp.showStatus",
      "when": "editorFocus && normalMode"
    },
    {
      "key": "space l r",
      "command": "lsp.restart",
      "when": "editorFocus && normalMode"
    },
    {
      "key": "space l c",
      "command": "editor.action.triggerSuggest",
      "when": "editorFocus && normalMode"
    },
    {
      "key": "f12",
      "command": "editor.action.revealDefinition",
      "when": "editorFocus && normalMode"
    },
    {
      "key": "g d",
      "command": "editor.action.revealDefinition",
      "when": "editorFocus && normalMode"
    },
    {
      "key": "g shift+d",
      "command": "editor.action.revealDeclaration",
      "when": "editorFocus && normalMode"
    },
    {
      "key": "g y",
      "command": "editor.action.goToTypeDefinition",
      "when": "editorFocus && normalMode"
    },
    {
      "key": "shift+f12",
      "command": "editor.action.goToReferences",
      "when": "editorFocus && normalMode"
    },
    {
      "key": "g r",
      "command": "editor.action.goToReferences",
      "when": "editorFocus && normalMode"
    },
    {
      "key": "space l o",
      "command": "workbench.action.gotoSymbol",
      "when": "editorFocus && normalMode"
    },
    {
      "key": "space l w",
      "command": "workbench.action.showAllSymbols",
      "when": "editorFocus && normalMode"
    },
    {
      "key": "f2",
      "command": "editor.action.rename",
      "when": "editorFocus && normalMode"
    },
    {
      "key": "space l n",
      "command": "editor.action.rename",
      "when": "editorFocus && normalMode"
    },
    {
      "key": "space l a",
      "command": "editor.action.quickFix",
      "when": "editorFocus && normalMode"
    }
  ]
}
